# /etc/beanstalk.env
#
# Secrets. chmod 600, owned by root.
#   sudo install -m 600 -o root -g root beanstalk.env /etc/beanstalk.env

# From @BotFather after /newbot. THE WHOLE STRING, INCLUDING THE COLON AND THE
# DIGITS BEFORE IT. Splitting the token at the colon gives you a 404 from every
# Telegram call.
TELEGRAM_TOKEN=8123456789:AAHk3xamPLEt0kenDoNotUseThis1234567

# Leave blank. On first run the bridge prints a pairing code. The chat that
# sends it is the only chat the bridge answers.
TELEGRAM_CHAT_ID=

# HiveMQ. Make a SECOND credential for the bridge rather than reusing the
# panel's, so either password can be rotated without taking both ends down.
MQTT_HOST=xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=bridge
MQTT_PASS=

# Must differ from the panel's client id (sticky1234). Two MQTT clients
# sharing an id do not coexist: the broker drops the first, so a collision here
# knocks the panel offline every time this service restarts.
MQTT_CLIENT_ID=beanstalk

TOPIC_PREFIX=sticky

# INFO logs that messages moved. DEBUG logs what they said, into the journal,
# which keeps it. Leave at INFO unless you are looking at something specific.
LOG_LEVEL=INFO

# Battery publishes every 300s, so silence past this means the panel is off,
# flat, or off wifi.
DEVICE_SILENT_MINUTES=20
LOW_BATTERY_PCT=15

# Where firmware builds are hosted for /update. Bare hostname. Only URLs on
# this host are passed to the panel. Blank turns /update off.
OTA_HOST=
