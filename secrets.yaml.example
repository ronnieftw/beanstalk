# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and should never
# be committed

# ESPHome hard-fails on a missing !secret key, so every entry here must exist
# even if the feature is unused.

# The name shown at the top of the panel.
sender_name: "Mama"

# Your home network. 
wifi_ssid: "..."
wifi_password: "..."

# Second network [optional]
#
# Lets the Sticky connect in two places. Leave the placeholders if you only
# have one network: an SSID that does not exist is not found.
#
# Comment these out if you would rather they were not here, but then comment
# out the matching entry under wifi: networks: in sticky.yaml as well. ESPHome
# hard-fails on a !secret key the config asks for and this file lacks.
wifi_ssid_alt: "..."
wifi_password_alt: "..."

# Password for Beanstalk Setup, the network the panel raises when it finds no
# wifi it knows. The name is ap_ssid in sticky.yaml, and the panel shows it on
# screen so it can be read.
#
# Keep this SHORT AND SPEAKABLE if you want to make adding another wifi network
# easy when guiding a third party. A generated string makes that recovery
# path harder.
#
# It also prints in plaintext in the serial log, so it is not a strong secret.
ap_password: "..."

ota_password: "..."

# Basic auth the panel sends when it pulls a firmware build over HTTPS
# (remote updates). The same pair is set on the server. Leave the
# placeholders if you do not host firmware.
ota_http_username: "sticky"
ota_http_password: "..."

# HiveMQ Cloud. Bare hostname — no scheme, no port. Those are separate keys.
mqtt_broker: "xxxxxxxx.s1.eu.hivemq.cloud"
mqtt_username: "..."
mqtt_password: "..."

# Unused. There is no api: block: api: and mqtt: together reboot the device
# every 15 minutes when no API client connects. The key stays because removing
# a !secret key that nothing references is harmless and removing one that
# something does is a hard failure.
api_encryption_key: "..."
